{
  "info": {
    "name": "Employee Management API",
    "description": "Auth, Users (Employees), Projects, and Tasks APIs. Import this file directly into Postman (File > Import). Set `baseUrl` in the collection variables if not running on localhost:5000. Run 'Login' first — it auto-saves accessToken/refreshToken into collection variables used by every other request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "userId", "value": "1" },
    { "key": "projectId", "value": "1" },
    { "key": "taskId", "value": "1" },
    { "key": "employeeId", "value": "1" },
    { "key": "managerId", "value": "1" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_email\": \"admin@company.com\",\n  \"user_password\": \"Admin@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "description": "No auth required. Roles: any (Delivery Manager, Project Manager, Team Lead, Employee)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success) {",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "auth", "refresh"] },
            "description": "No auth required. Rotates the refresh token — old one is invalidated."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success) {",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] },
            "description": "No auth required."
          }
        }
      ]
    },
    {
      "name": "Users (Employees)",
      "item": [
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role_id\": 4,\n  \"user_name\": \"Jane Employee\",\n  \"user_email\": \"jane.employee@company.com\",\n  \"user_password\": \"Pass@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/create", "host": ["{{baseUrl}}"], "path": ["api", "users", "create"] },
            "description": "Role required: Delivery Manager.\nrole_id: 1=Team Lead, 2=Project Manager, 3=Delivery Manager, 4=Employee.\nuser_password must be at least 6 characters."
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/getAll?page=1&limit=10&search=&role_id=&user_status=&user_type=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "getAll"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "", "description": "matches user_name or user_email" },
                { "key": "role_id", "value": "", "description": "1=TL, 2=PM, 3=DM, 4=Employee" },
                { "key": "user_status", "value": "", "description": "Y or N" },
                { "key": "user_type", "value": "", "description": "T, P, D, or E" }
              ]
            },
            "description": "Role: any authenticated user (scoped by org hierarchy — you only see roles strictly below you)."
          }
        },
        {
          "name": "Get User By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/getOne/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "getOne", "{{userId}}"]
            }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_name\": \"Jane E. Employee\",\n  \"user_status\": \"Y\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/update/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "update", "{{userId}}"]
            },
            "description": "Role required: Delivery Manager. All fields optional (at least one required): role_id, user_name, user_email, user_password, user_status (Y/N)."
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/delete/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "delete", "{{userId}}"]
            },
            "description": "Role required: Delivery Manager. Soft delete."
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_name\": \"Website Revamp\",\n  \"project_description\": \"Redesign the marketing site\",\n  \"project_status\": \"P\",\n  \"project_start_date\": \"2026-08-01\",\n  \"project_end_date\": \"2026-12-31\",\n  \"project_manager_id\": 9,\n  \"assigned_ids\": [10]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/projects/create", "host": ["{{baseUrl}}"], "path": ["api", "projects", "create"] },
            "description": "Role required: Delivery Manager or Project Manager.\nproject_status: P=pending, A=active, C=completed, H=on hold, X=cancelled.\nAll fields optional except project_name."
          }
        },
        {
          "name": "List Projects",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/getAll?page=1&limit=10&search=&project_status=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "getAll"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "", "description": "matches project_name" },
                { "key": "project_status", "value": "", "description": "P, A, C, H, or X" }
              ]
            },
            "description": "Role: any authenticated user (scoped — DM sees all, PM sees own-managed, others see projects they're a member of)."
          }
        },
        {
          "name": "Get Project By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/getOne/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "getOne", "{{projectId}}"]
            }
          }
        },
        {
          "name": "Update Project",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_status\": \"A\",\n  \"assigned_ids\": [10, 11]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects/update/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "update", "{{projectId}}"]
            },
            "description": "Role required: Delivery Manager, Project Manager, or Team Lead.\nTeam Leads may ONLY send assigned_ids — any other field returns 403.\nAll fields optional (at least one required): project_name, project_description, project_status, project_start_date, project_end_date, project_manager_id, assigned_ids (replaces the full member list)."
          }
        },
        {
          "name": "Delete Project",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/delete/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "delete", "{{projectId}}"]
            },
            "description": "Role required: Delivery Manager or Project Manager. Soft delete."
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_title\": \"Build login page\",\n  \"task_description\": \"Implement SSO login flow\",\n  \"task_project_id\": {{projectId}},\n  \"task_assigned_employee_id\": {{employeeId}},\n  \"task_assigned_manager_id\": {{managerId}},\n  \"task_status\": \"P\",\n  \"task_priority\": \"H\",\n  \"task_due_date\": \"2026-08-15\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/tasks/create", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "create"] },
            "description": "Role required: Team Lead, Project Manager, or Delivery Manager (with manage-access to the project).\ntask_status: P=pending, I=in progress, C=completed, H=on hold.\ntask_priority: L=low, M=medium, H=high, U=urgent.\ntask_assigned_employee_id must be a project member with role Employee.\ntask_assigned_manager_id is optional — defaults to the requester."
          }
        },
        {
          "name": "List Tasks (with filters)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/getAll?page=1&limit=10&search=&task_status=&task_priority=&task_project_id=&due_before=&due_after=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "getAll"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "", "description": "matches task_title" },
                { "key": "task_status", "value": "", "description": "P, I, C, or H" },
                { "key": "task_priority", "value": "", "description": "L, M, H, or U" },
                { "key": "task_project_id", "value": "" },
                { "key": "due_before", "value": "", "description": "YYYY-MM-DD" },
                { "key": "due_after", "value": "", "description": "YYYY-MM-DD" }
              ]
            },
            "description": "Role: any authenticated user (scoped — DM sees all, PM/TL see their team's tasks, Employee sees only their own)."
          }
        },
        {
          "name": "Get Task By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/getOne/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "getOne", "{{taskId}}"]
            }
          }
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_priority\": \"U\",\n  \"task_due_date\": \"2026-08-20\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/update/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "update", "{{taskId}}"]
            },
            "description": "Role required: Team Lead, Project Manager, or Delivery Manager (with manage-access to the project).\nAll fields optional (at least one required): task_title, task_description, task_status, task_priority, task_due_date, task_assigned_employee_id, task_assigned_manager_id."
          }
        },
        {
          "name": "Update Task Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_status\": \"I\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/update-status/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "update-status", "{{taskId}}"]
            },
            "description": "Role: any authenticated user. An Employee may update ONLY their own task's status; a manager may update status on tasks in projects they manage.\ntask_status: P=pending, I=in progress, C=completed, H=on hold."
          }
        },
        {
          "name": "Get Tasks By Employee",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/employee/{{employeeId}}?page=1&limit=10&task_status=&task_priority=&task_project_id=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "employee", "{{employeeId}}"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "task_status", "value": "" },
                { "key": "task_priority", "value": "" },
                { "key": "task_project_id", "value": "" }
              ]
            },
            "description": "Role: Employee may fetch only their own (employeeId must match their own user id); a manager may fetch any employee visible to them in the org hierarchy."
          }
        },
        {
          "name": "Get Tasks By Manager",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/manager/{{managerId}}?page=1&limit=10&task_status=&task_priority=&task_project_id=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "manager", "{{managerId}}"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "task_status", "value": "" },
                { "key": "task_priority", "value": "" },
                { "key": "task_project_id", "value": "" }
              ]
            },
            "description": "Role: a manager (TL/PM/DM) may fetch only their own (managerId must match their own user id); a Delivery Manager may fetch any manager's."
          }
        }
      ]
    }
  ]
}
